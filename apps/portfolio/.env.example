# Endpoint que recibe el formulario de contacto (POST JSON): el Worker de apps/api + /contact,
# ej. https://portfolio-api.<subdominio>.workers.dev/contact (en local: http://127.0.0.1:8787/contact).
# Vacío = el formulario se muestra deshabilitado e invita a escribir por LinkedIn.
PUBLIC_CONTACT_ENDPOINT=

# Clave pública (site key) de Cloudflare Turnstile. Vacía = no se carga el script ni el widget.
PUBLIC_TURNSTILE_SITE_KEY=
