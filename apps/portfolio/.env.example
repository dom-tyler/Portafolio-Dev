# URL pública del endpoint que recibe el formulario de contacto (POST JSON).
# El backend (p. ej. Firebase Function + Resend + Firestore) guarda el mensaje, avisa al admin y
# reenvía al correo de trabajo. Ese correo vive solo en el servidor, nunca aquí.
# Vacío = el formulario se muestra deshabilitado e invita a escribir por LinkedIn.
PUBLIC_CONTACT_ENDPOINT=
