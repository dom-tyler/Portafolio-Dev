# Endpoint que recibe el formulario de contacto (POST JSON). En producción: /api/contact
# (rewrite de Firebase Hosting a la función de apps/contact-api, mismo origen).
# Vacío = el formulario se muestra deshabilitado e invita a escribir por LinkedIn.
PUBLIC_CONTACT_ENDPOINT=

# Clave pública (site key) de Cloudflare Turnstile. Vacía = no se carga el script ni el widget.
PUBLIC_TURNSTILE_SITE_KEY=
