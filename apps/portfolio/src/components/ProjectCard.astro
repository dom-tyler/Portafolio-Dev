---
import type { Project } from '@portfolio/content-schema';
import LayerDiagram from './LayerDiagram.astro';
import TechIcon from './TechIcon.astro';
import { statusLabel } from '../lib/labels';

interface Props {
  project: Project;
  index: number;
  variant?: 'feature' | 'compact';
}

const { project: p, index, variant = 'feature' } = Astro.props;
const num = String(index + 1).padStart(2, '0');
---

<article class:list={['card frame', `card--${variant}`]} data-reveal>
  <a href={`/proyectos/${p.slug}`} class="card-link" aria-label={`${p.title}: ver caso`}></a>
  <header class="card-head">
    <span class="hud text-copper">{num}</span>
    <span class="hud status" data-status={p.status}>
      <span class:list={['led', { 'led--neon': p.status === 'en-desarrollo' }]} aria-hidden="true"></span>
      {statusLabel[p.status]}
    </span>
  </header>

  <div class="card-body">
    <p class="hud text-faint">{p.context}</p>
    <h3 class="card-title">{p.title}</h3>
    <p class="card-tagline">{p.tagline}</p>
  </div>

  {
    variant === 'feature' && (
      <div class="card-layers">
        <LayerDiagram layers={p.layers} />
      </div>
    )
  }

  <footer class="card-foot">
    <ul class="stack" aria-label="Tecnologías">
      {
        p.stack.slice(0, variant === 'feature' ? 6 : 4).map((s) => (
          <li class="hud chip">
            <TechIcon name={s} size={11} />
            {s}
          </li>
        ))
      }
    </ul>
    <span class="hud go" aria-hidden="true">Caso →</span>
  </footer>
</article>

<style>
  .card {
    position: relative;
    display: grid;
    gap: 1.5rem;
    align-content: start;
    padding: clamp(1.25rem, 2.2vw, 2rem);
    background: color-mix(in oklab, var(--c-graphite) 96%, var(--c-ivory));
    transition:
      border-color 0.35s var(--ease-out),
      background-color 0.35s var(--ease-out);
  }
  .card:hover,
  .card:focus-within {
    border-color: var(--c-line-strong);
    background: color-mix(in oklab, var(--c-graphite) 93%, var(--c-ivory));
  }
  .card:hover::before,
  .card:hover::after,
  .card:focus-within::before,
  .card:focus-within::after {
    border-color: var(--c-neon);
  }
  .card-link {
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .card-link:focus-visible {
    outline-offset: -1px;
  }
  .card-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--c-muted);
  }
  .status[data-status='caso-privado'] .led,
  .status[data-status='academico'] .led {
    background: var(--c-copper);
    box-shadow: none;
  }
  .card-body {
    display: grid;
    gap: 0.6rem;
  }
  .card-title {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.3vw, 2rem);
    line-height: 1.05;
    font-weight: 650;
    letter-spacing: -0.03em;
  }
  .card--compact .card-title {
    font-size: 1.2rem;
  }
  .card-tagline {
    color: var(--c-muted);
    max-width: 44ch;
  }
  .card-foot {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1rem;
    margin-top: auto;
  }
  .stack {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.5rem;
    border: 1px solid var(--c-line);
    color: var(--c-muted);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
  }
  .go {
    flex-shrink: 0;
    color: var(--c-faint);
    transition:
      color 0.3s,
      transform 0.3s var(--ease-out);
  }
  .card:hover .go {
    color: var(--c-neon);
    transform: translateX(4px);
  }
</style>
