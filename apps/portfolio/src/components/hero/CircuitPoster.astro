---
/**
 * Póster de la escena 1: placa de circuito con corriente animada por CSS.
 * Sirve como primer cuadro (LCP), como fallback sin WebGL/video y para prefers-reduced-motion.
 */
import { buildBoard } from '../../lib/circuit';

const b = buildBoard();
const { chip } = b;
const half = chip.size / 2;
---

<div class="poster" aria-hidden="true">
  <svg viewBox={`0 0 ${b.width} ${b.height}`} preserveAspectRatio="xMidYMid slice" role="presentation">
    <defs>
      <pattern id="pcb-grid" width="24" height="24" patternUnits="userSpaceOnUse">
        <circle cx="12" cy="12" r="0.9" fill="var(--c-ivory)" opacity="0.07"></circle>
      </pattern>
      <radialGradient id="pcb-vignette" cx="70%" cy="50%" r="70%">
        <stop offset="0" stop-color="var(--c-soldermask)" stop-opacity="1"></stop>
        <stop offset="0.55" stop-color="var(--c-graphite)" stop-opacity="0.65"></stop>
        <stop offset="1" stop-color="var(--c-graphite)" stop-opacity="1"></stop>
      </radialGradient>
      <radialGradient id="die-glow" cx="50%" cy="50%" r="50%">
        <stop offset="0" stop-color="var(--c-neon)" stop-opacity="0.55"></stop>
        <stop offset="1" stop-color="var(--c-neon)" stop-opacity="0"></stop>
      </radialGradient>
    </defs>

    <rect width="100%" height="100%" fill="var(--c-graphite)"></rect>
    <rect width="100%" height="100%" fill="url(#pcb-vignette)"></rect>
    <rect width="100%" height="100%" fill="url(#pcb-grid)"></rect>

    <!-- Buses tenues -->
    <g class="bus" fill="none" stroke="var(--c-copper)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
      {b.bus.map((d) => <path d={d} />)}
    </g>

    <!-- Pistas de cobre -->
    <g fill="none" stroke="var(--c-copper)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="traces">
      {b.traces.map((t) => <path d={t.d} />)}
    </g>

    <!-- Pads y vías -->
    <g class="pads">
      {
        b.traces.map((t) => (
          <g>
            <circle cx={t.end[0]} cy={t.end[1]} r="5.5" fill="var(--c-graphite)" stroke="var(--c-copper)" stroke-width="2" />
            <circle cx={t.end[0]} cy={t.end[1]} r="1.8" fill="var(--c-copper)" />
          </g>
        ))
      }
      {b.vias.map(([x, y]) => <circle cx={x} cy={y} r="2.4" fill="none" stroke="var(--c-copper)" stroke-width="1" opacity="0.35" />)}
    </g>

    <!-- Corriente: halo ancho + núcleo fino (sin filtros de blur, para rendimiento) -->
    <g class="current" fill="none" stroke-linecap="round" stroke-linejoin="round">
      {
        b.traces
          .filter((t) => t.live)
          .map((t) => (
            <g style={`--delay:${t.delay}s;--dur:${t.duration}s`}>
              <path d={t.d} pathLength="100" class="halo" />
              <path d={t.d} pathLength="100" class="core" />
            </g>
          ))
      }
    </g>

    <!-- Chip -->
    <g class="chip">
      <circle cx={chip.x} cy={chip.y} r={chip.size * 1.15} fill="url(#die-glow)" class="die-glow"></circle>
      {b.pins.map((p) => <rect x={p.x} y={p.y} width={p.w} height={p.h} fill="var(--c-copper)" />)}
      <rect
        x={chip.x - half}
        y={chip.y - half}
        width={chip.size}
        height={chip.size}
        fill="color-mix(in oklab, var(--c-graphite) 94%, var(--c-ivory))"
        stroke="var(--c-line-strong)"
        stroke-width="1"></rect>
      <rect
        x={chip.x - half + 14}
        y={chip.y - half + 14}
        width={chip.size - 28}
        height={chip.size - 28}
        fill="none"
        stroke="var(--c-line)"
        stroke-width="1"></rect>
      <circle cx={chip.x - half + 26} cy={chip.y - half + 26} r="4" fill="none" stroke="var(--c-faint)" stroke-width="1"></circle>
      <g class="die">
        <rect x={chip.x - 32} y={chip.y - 32} width="64" height="64" fill="var(--c-neon)" opacity="0.92"></rect>
        <path
          d={`M${chip.x - 32} ${chip.y - 16}h64M${chip.x - 32} ${chip.y}h64M${chip.x - 32} ${chip.y + 16}h64M${chip.x - 16} ${chip.y - 32}v64M${chip.x} ${chip.y - 32}v64M${chip.x + 16} ${chip.y - 32}v64`}
          stroke="var(--c-graphite)"
          stroke-width="1"
          opacity="0.45"></path>
        <rect x={chip.x - 9} y={chip.y - 9} width="18" height="18" fill="var(--c-ivory)" opacity="0.85"></rect>
      </g>
      <text x={chip.x} y={chip.y + half - 30} text-anchor="middle" class="chip-label">DO·26 / ARCH-CORE</text>
      <text x={chip.x} y={chip.y + half - 16} text-anchor="middle" class="chip-label chip-label--dim">MDE·CO — REV 7</text>
    </g>
  </svg>
</div>

<style>
  .poster {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .poster svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  /* Móvil: encuadre propio centrado en el chip (cx = 1120 / 1600 = 70%), por encima del texto. */
  @media (max-width: 767px) {
    .poster svg {
      position: absolute;
      top: 0;
      left: 50%;
      width: auto;
      height: 64%;
      aspect-ratio: 16 / 9;
      translate: -70% 0;
    }
  }
  .bus {
    opacity: 0.16;
  }
  .traces {
    opacity: 0.55;
  }
  .current .halo,
  .current .core {
    stroke: var(--c-neon);
    stroke-dasharray: 7 93;
    stroke-dashoffset: 100;
    animation: flow var(--dur) linear var(--delay) infinite;
  }
  .current .halo {
    stroke-width: 9;
    opacity: 0.18;
  }
  .current .core {
    stroke-width: 2.2;
  }
  @keyframes flow {
    to {
      stroke-dashoffset: 0;
    }
  }
  .die {
    animation: flicker 4.6s steps(1, end) infinite;
  }
  .die-glow {
    animation: breathe 5s var(--ease-in-out) infinite;
    transform-origin: center;
    transform-box: fill-box;
  }
  @keyframes breathe {
    50% {
      opacity: 0.55;
      transform: scale(0.94);
    }
  }
  /* Parpadeo irregular, como un arco eléctrico */
  @keyframes flicker {
    0%, 100% { opacity: 1; }
    41% { opacity: 1; }
    42% { opacity: 0.35; }
    43% { opacity: 1; }
    44% { opacity: 0.6; }
    46% { opacity: 1; }
    77% { opacity: 1; }
    78% { opacity: 0.4; }
    79% { opacity: 1; }
  }
  .chip-label {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.18em;
    fill: var(--c-muted);
  }
  .chip-label--dim {
    fill: var(--c-faint);
  }
  @media (prefers-reduced-motion: reduce) {
    .current .halo,
    .current .core {
      animation: none;
      stroke-dasharray: none;
      opacity: 0.3;
    }
    .current .halo {
      opacity: 0.06;
    }
  }
</style>
