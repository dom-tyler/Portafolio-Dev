---
import { site } from '../../content/site';
import FaceField from '../face/FaceField.astro';

const channels = [
  site.contact.email && { label: 'Correo', value: site.contact.email, href: `mailto:${site.contact.email}` },
  site.contact.linkedin && { label: 'LinkedIn', value: 'Perfil profesional', href: site.contact.linkedin },
  { label: 'GitHub', value: '@AresHidalgo', href: site.contact.github },
].filter(Boolean) as { label: string; value: string; href: string }[];
---

<section id="contacto" class="contact" aria-labelledby="contacto-title">
  <FaceField />
  <div class="shell contact-shell">
    <div class="section-head" data-reveal>
      <p class="hud hud-bracket text-copper">05 · Contacto</p>
      <h2 id="contacto-title" class="display">
        Conectemos<br /><span class="text-faint">el siguiente sistema.</span>
      </h2>
    </div>

    <ul class="channels" data-reveal>
      {
        channels.map((c) => (
          <li>
            <a href={c.href} class="channel" target={c.href.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer">
              <span class="hud text-faint">{c.label}</span>
              <span class="channel-value">{c.value}</span>
              <span class="hud channel-go" aria-hidden="true">
                ↗
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="hud status" data-reveal>
      <span class="led" aria-hidden="true"></span>
      {site.location} · Disponible para proyectos y equipos de producto
    </p>
  </div>
</section>

<style>
  /* Cierre: el texto a la izquierda y, a la derecha, el rostro que arma el fondo de píxeles. */
  .contact {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }
  .contact-shell > * {
    max-width: 40rem;
  }
  @media (max-width: 767px) {
    .contact {
      display: block;
      min-height: 0;
      /* Espacio arriba para el rostro en móvil */
      padding-top: min(52svh, 92vw);
    }
  }
  .channels {
    list-style: none;
    border-top: 1px solid var(--c-line);
  }
  .channel {
    display: grid;
    grid-template-columns: 6rem 1fr auto;
    align-items: baseline;
    gap: 1rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--c-line);
    transition: padding-left 0.4s var(--ease-out);
  }
  .channel:hover {
    padding-left: 0.75rem;
  }
  .channel-value {
    font-size: clamp(1.25rem, 2.6vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    transition: color 0.3s;
  }
  .channel:hover .channel-value {
    color: var(--c-neon);
  }
  .channel-go {
    color: var(--c-faint);
    font-size: 1rem;
  }
  .status {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 2rem;
    color: var(--c-muted);
  }
</style>
