---
import { experience } from '../../content/experience';
import TechIcon from '../TechIcon.astro';

const kindLabel = { trabajo: 'Trabajo', formacion: 'Formación', comunidad: 'Comunidad' } as const;
---

<section id="experiencia" aria-labelledby="experiencia-title">
  <div class="shell">
    <div class="section-head" data-reveal>
      <p class="hud hud-bracket text-copper">03 · Experiencia</p>
      <h2 id="experiencia-title" class="title-lg">Trayectoria</h2>
    </div>

    <ol class="timeline">
      {
        experience.map((e) => (
          <li class="row" data-reveal>
            <span class="hud period">{e.period}</span>
            <div class="who">
              <h3 class="org">{e.org}</h3>
              <p class="hud role">
                {e.role} · <span class="text-faint">{kindLabel[e.kind]}</span>
              </p>
            </div>
            <p class="summary">{e.summary}</p>
            <ul class="tags" aria-label="Tecnologías">
              {e.stack.map((s) => (
                <li class="hud">
                  <TechIcon name={s} size={12} />
                  {s}
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .timeline {
    list-style: none;
    border-top: 1px solid var(--c-line);
  }
  .row {
    position: relative;
    display: grid;
    gap: 0.75rem;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--c-line);
    transition: background-color 0.3s;
  }
  .row::before {
    content: '';
    position: absolute;
    left: 0;
    top: -1px;
    height: 1px;
    width: 100%;
    background: var(--c-neon);
    box-shadow: var(--glow-sm);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s var(--ease-out);
  }
  .row:hover::before {
    transform: scaleX(1);
  }
  @media (min-width: 900px) {
    .row {
      grid-template-columns: 9rem 1.1fr 1.4fr 1fr;
      align-items: baseline;
      gap: 2rem;
    }
  }
  .period {
    color: var(--c-copper);
  }
  .org {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  .role {
    color: var(--c-muted);
    margin-top: 0.35rem;
    letter-spacing: 0.08em;
  }
  .summary {
    color: var(--c-muted);
  }
  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.9rem;
    color: var(--c-faint);
  }
  .tags li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  @media (min-width: 900px) {
    .tags {
      justify-content: flex-end;
    }
  }
</style>
