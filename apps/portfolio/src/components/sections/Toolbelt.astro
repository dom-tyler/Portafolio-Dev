---
import { toolbelt } from '../../content/experience';
import TechIcon from '../TechIcon.astro';
---

<section aria-labelledby="stack-title">
  <div class="shell">
    <div class="section-head" data-reveal>
      <p class="hud hud-bracket text-copper">04 · Stack</p>
      <h2 id="stack-title" class="title-lg">Herramientas por capa</h2>
    </div>

    <div class="board frame" data-reveal>
      {
        toolbelt.map((t, i) => (
          <div class="cell">
            <p class="hud cell-head">
              <span class="text-faint">{String(i).padStart(2, '0')}</span>
              <TechIcon name={t.layer} size={14} />
              {t.layer}
            </p>
            <ul>
              {t.items.map((item) => (
                <li>
                  <TechIcon name={item} size={15} class="ico" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .board {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }
  @media (min-width: 768px) {
    .board {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .cell {
    padding: 1.25rem;
    border-right: 1px solid var(--c-line);
    border-bottom: 1px solid var(--c-line);
    transition: background-color 0.3s;
  }
  .cell:hover {
    background: color-mix(in oklab, var(--c-soldermask) 60%, transparent);
  }
  .cell-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--c-copper);
    margin-bottom: 0.9rem;
  }
  ul {
    list-style: none;
    display: grid;
    gap: 0.45rem;
    font-size: 0.9375rem;
    color: var(--c-muted);
  }
  .cell:hover li {
    color: var(--c-ivory);
  }
  li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    transition: color 0.3s;
  }
  /* El ícono va un paso por debajo del texto y toma el cobre al pasar por la capa. */
  li :global(.ico) {
    color: var(--c-faint);
    transition:
      color 0.3s,
      transform 0.3s var(--ease-out);
  }
  .cell:hover li :global(.ico) {
    color: var(--c-copper);
  }
  li:hover :global(.ico) {
    transform: translateY(-1px);
  }
</style>
