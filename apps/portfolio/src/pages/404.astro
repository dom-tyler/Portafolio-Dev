---
import Base from '../layouts/Base.astro';
---

<Base title="Ruta no encontrada">
  <div class="shell wrap">
    <p class="hud text-neon">ERR · 404 · Circuito abierto</p>
    <h1 class="display">Esta pista<br /><span class="text-faint">no conecta con nada.</span></h1>
    <div class="actions">
      <a href="/" class="btn btn--primary">Volver al inicio <span class="arrow" aria-hidden="true">→</span></a>
      <a href="/proyectos" class="btn">Ver proyectos</a>
    </div>
  </div>
</Base>

<style>
  .wrap {
    min-height: 80svh;
    display: grid;
    align-content: center;
    gap: 1.5rem;
    padding-top: 6rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
