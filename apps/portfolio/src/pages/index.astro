---
import Base from '../layouts/Base.astro';
import Hero from '../components/hero/Hero.astro';
import HeroWebGL from '../components/hero/HeroWebGL.astro';
import BootFlag from '../components/hero/BootFlag.astro';
import Featured from '../components/sections/Featured.astro';
import Approach from '../components/sections/Approach.astro';
import Experience from '../components/sections/Experience.astro';
import Toolbelt from '../components/sections/Toolbelt.astro';
import Contact from '../components/sections/Contact.astro';
---

<Base>
  <BootFlag slot="head" />
  <Hero>
    <HeroWebGL slot="media" />
  </Hero>
  <Featured />
  <Approach />
  <Experience />
  <Toolbelt />
  <Contact />
</Base>
