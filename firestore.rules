rules_version = '2';

// Reglas compartidas entre el sitio público y el admin (dom-tyler/AD-Portafolio).
// El formulario escribe solo a través del Worker apps/api (cuenta de servicio, que no pasa por estas reglas).
// Si el admin agrega colecciones, extiende este archivo: el último despliegue de reglas reemplaza al anterior.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Mensajes del formulario: el admin los lee, los marca como leídos o los borra. Nadie crea desde el cliente.
    match /messages/{id} {
      allow read, delete: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'read', 'notes']);
      allow create: if false;
    }

    // Contenido del sitio: lo edita el admin; el sitio lo lee al compilar con el Admin SDK.
    match /projects/{slug} {
      allow read, write: if isAdmin();
    }
    match /experience/{id} {
      allow read, write: if isAdmin();
    }
    match /toolbelt/{id} {
      allow read, write: if isAdmin();
    }

    // Historial de publicaciones: lo escriben el Worker apps/api y el CI.
    match /publishes/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Contadores de rate limit: solo la función.
    match /rateLimits/{id} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
